{
  "semantic": {
    "color": {
      "$type": "color",
      "primary": { "solid": { "$value": "{semantic.color.crt.ink}" } },
      "text": {
        "base": { "$value": "{semantic.color.crt.ink}" },
        "muted": { "$value": "{semantic.color.crt.ink-dim}" }
      },
      "elevation": {
        "0": { "surface": { "$value": "{semantic.color.crt.tube}" } },
        "1": { "surface": { "$value": "{semantic.color.crt.glass}" } }
      },
      "border": { "$value": "{semantic.color.crt.scanline}" },
      "warning": { "solid": { "$value": "{semantic.color.crt.amber}" } },
      "danger": { "solid": { "$value": "{semantic.color.crt.meltdown}" } }
    },
    "radius": {
      "md": { "$type": "dimension", "$value": "0rem" }
    },
    "font": {
      "sans": { "$type": "fontFamily", "$value": "{option.font.mono}" },
      "mono": { "$type": "fontFamily", "$value": "{option.font.mono}" }
    }
  }
}
