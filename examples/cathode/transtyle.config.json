{
  "$schema": "https://transtyle.dev/schemas/config/v0.json",
  "name": "cathode-terminal",
  "tokens": ["tokens/*.tokens.json"],
  "modes": {
    "color-scheme": { "values": ["dark", "light"], "default": "dark" }
  },
  "derivation": {
    "rules": "standard@1",
    "autoDark": false,
    "require": ["semantic.color.primary"]
  },
  "targets": {
    "shadcn": {
      "output": "dist/shadcn",
      "options": { "era": "tailwind-v4" }
    }
  },
  "check": {
    "failOn": "error",
    "contrast": { "standard": "wcag21-aa" }
  }
}
