{
  "$schema": "https://transtyle.dev/schemas/config/v0.json",
  "name": "cathode-terminal",
  "tokens": [
    "tokens/cathode.tokens.json",
    {
      "files": "tokens/cathode.light.tokens.json",
      "mode": {
        "color-scheme": "light"
      }
    },
    "tokens/transtyle.bindings.tokens.json"
  ],
  "modes": {
    "color-scheme": {
      "values": [
        "dark",
        "light"
      ],
      "default": "dark"
    }
  },
  "derivation": {
    "rules": "standard@1",
    "autoDark": false,
    "require": [
      "semantic.color.primary"
    ]
  },
  "targets": {
    "shadcn": {
      "output": "dist/shadcn",
      "options": {
        "era": "tailwind-v4"
      }
    },
    "echarts": {
      "output": "dist/echarts"
    },
    "daisyui": {
      "output": "dist/daisyui"
    },
    "bootstrap": {
      "output": "dist/bootstrap"
    },
    "storybook": {
      "output": "dist/storybook",
      "options": {
        "previewTargets": ["shadcn", "daisyui"],
        "brand": {
          "url": "https://transtyle.github.io/transtyle/",
          "image": "/logo.png"
        }
      }
    },
    "css-variables": {
      "output": "dist/css-variables"
    },
    "radix": {
      "output": "dist/radix"
    },
    "primeng": {
      "output": "dist/primeng"
    }
  },
  "check": {
    "failOn": "error",
    "contrast": {
      "standard": "wcag21-aa"
    }
  }
}
