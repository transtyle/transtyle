      },
      "gray": {
        "50": { "$value": "oklch(0.985 0.003 255)" },
        "100": { "$value": "oklch(0.96 0.004 255)" },
        "200": { "$value": "oklch(0.92 0.006 255)" },
        "400": { "$value": "oklch(0.7 0.01 255)" },
        "500": { "$value": "oklch(0.55 0.012 255)" },
        "800": { "$value": "oklch(0.3 0.012 255)" },
        "900": { "$value": "oklch(0.22 0.012 255)" },
        "950": { "$value": "oklch(0.15 0.01 255)" }
