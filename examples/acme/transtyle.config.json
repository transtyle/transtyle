{
  "$schema": "https://transtyle.dev/schemas/config/v0.json",
  "name": "acme-design-system",
  "tokens": [
    "tokens/option.tokens.json",
    "tokens/semantic.tokens.json",
    {
      "files": "tokens/acme.density-compact.tokens.json",
      "mode": { "density": "compact" }
    }
  ],
  "modes": {
    "color-scheme": {
      "values": [
        "light",
        "dark"
      ],
      "default": "light"
    },
    "density": {
      "values": [
        "comfortable",
        "compact"
      ],
      "default": "comfortable"
    }
  },
  "derivation": {
    "rules": "standard@1",
    "autoDark": false,
    "require": [
      "semantic.color.primary"
    ]
  },
  "targets": {
    "shadcn": {
      "output": "dist/shadcn",
      "options": {
        "era": "tailwind-v4"
      }
    },
    "shadcn-v3": {
      "exporter": "shadcn",
      "output": "dist/shadcn-v3",
      "options": {
        "era": "tailwind-v3"
      }
    },
    "echarts": {
      "output": "dist/echarts"
    },
    "daisyui": {
      "output": "dist/daisyui"
    },
    "bootstrap": {
      "output": "dist/bootstrap"
    },
    "storybook": {
      "output": "dist/storybook",
      "options": {
        "previewTargets": ["shadcn", "daisyui"],
        "brand": {
          "url": "https://transtyle.github.io/transtyle/",
          "image": "logo.png"
        }
      }
    },
    "css-variables": {
      "output": "dist/css-variables"
    },
    "radix": {
      "output": "dist/radix"
    },
    "primeng": {
      "output": "dist/primeng"
    }
  },
  "check": {
    "failOn": "error",
    "contrast": {
      "standard": "wcag21-aa"
    }
  }
}
