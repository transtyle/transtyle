{
  "$schema": "https://transtyle.dev/schemas/config/v0.json",
  "name": "govuk-design-system",
  "tokens": [
    "tokens/option.tokens.json",
    "tokens/semantic.tokens.json",
    "tokens/transtyle.bindings.tokens.json"
  ],
  "modes": {
    "color-scheme": {
      "values": ["light"],
      "default": "light"
    }
  },
  "derivation": {
    "rules": "standard@1",
    "autoDark": false,
    "require": ["semantic.color.primary"]
  },
  "targets": {
    "shadcn": { "output": "dist/shadcn", "options": { "era": "tailwind-v4" } },
    "echarts": { "output": "dist/echarts" },
    "daisyui": { "output": "dist/daisyui" },
    "bootstrap": { "output": "dist/bootstrap" },
    "storybook": {
      "output": "dist/storybook",
      "options": {
        "previewTargets": ["shadcn", "daisyui"],
        "brand": { "url": "https://transtyle.github.io/transtyle/", "image": "logo.png" }
      }
    },
    "css-variables": { "output": "dist/css-variables" },
    "radix": { "output": "dist/radix" },
    "primeng": { "output": "dist/primeng" },
    "mantine": { "output": "dist/mantine" },
    "chakra": { "output": "dist/chakra" },
    "mui": { "output": "dist/mui" }
  },
  "check": {
    "failOn": "error",
    "contrast": { "standard": "wcag21-aa" },
    "suppress": [
      {
        "code": "TST2101",
        "path": "ring",
        "reason": "GOV.UK's yellow focus state (#ffdd00) is paired with a dark text-colored outline, so the indicator meets WCAG 1.4.11 as a whole; the yellow alone is under 3:1 on white."
      }
    ]
  }
}
