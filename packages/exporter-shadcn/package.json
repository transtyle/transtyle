{
  "name": "@transtyle/exporter-shadcn",
  "version": "0.1.0-alpha.3",
  "description": "Transtyle exporter for shadcn/ui (tailwind-v4 era).",
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "theming",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "tailwind-v4",
    "radix",
    "css-variables"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@transtyle/ir": "0.1.0-alpha.3"
  },
  "transtyle": {
    "kind": "exporter",
    "name": "shadcn",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": {
      "shadcn": [
        "tailwind-v3",
        "tailwind-v4"
      ]
    },
    "modes": [
      "color-scheme"
    ],
    "capabilities": [
      "build"
    ]
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transtyle/transtyle.git",
    "directory": "packages/exporter-shadcn"
  },
  "homepage": "https://transtyle.github.io/transtyle/docs/exporter-shadcn/",
  "bugs": "https://github.com/transtyle/transtyle/issues",
  "license": "MIT"
}
