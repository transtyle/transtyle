{
  "option": {
    "color": {
      "$type": "color",
      "blue": { "600": { "$value": "#1d5fd1" }, "300": { "$value": "#7aa7f5" } },
      "violet": { "600": { "$value": "#7a3fd1" }, "300": { "$value": "#b996f2" } },
      "gray": {
        "50": { "$value": "#f8f9fb" },
        "200": { "$value": "#e2e5ea" },
        "400": { "$value": "#9aa1ad" },
        "500": { "$value": "#6b7280" },
        "700": { "$value": "#374151" },
        "800": { "$value": "#1f2633" },
        "900": { "$value": "#121722" },
        "950": { "$value": "#0a0d14" }
      },
      "white": { "$value": "#ffffff" },
      "black": { "$value": "#000000" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "primary": {
        "solid": {
          "$value": "{option.color.blue.600}",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.blue.300}" } } }
        }
      },
      "elevation": {
        "0": {
          "surface": {
            "$value": "{option.color.white}",
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.gray.950}" } } }
          }
        },
        "1": {
          "surface": {
            "$value": "{option.color.gray.50}",
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.gray.900}" } } }
          }
        }
      },
      "text": {
        "base": {
          "$value": "{option.color.gray.900}",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.gray.50}" } } }
        },
        "muted": {
          "$value": "{option.color.gray.500}",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.gray.400}" } } }
        }
      },
      "border": {
        "$value": "{option.color.gray.200}",
        "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "{option.color.gray.800}" } } }
      },
      "ring": {
        "$value": "{option.color.blue.600}",
        "$extensions": {
          "transtyle.modes": { "color-scheme": { "dark": "{option.color.blue.300}" }, "brand": { "globex": "{option.color.violet.600}" } }
        }
      }
    },
    "radius": { "md": { "$type": "dimension", "$value": "0.5rem" } },
    "font": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    }
  }
}
