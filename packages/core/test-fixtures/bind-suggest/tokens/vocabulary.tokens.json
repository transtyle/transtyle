{
  "$schema": "https://transtyle.dev/schemas/tokens/v0.json",
  "$description": "A regular vocabulary for `transtyle bind --suggest` (scripts/check-cli.mjs): roles, rungs and levels named by the catalog's own words, so the suggestion generalizes into three bindings rules, and two brand names with different colors, so primary.solid is contested.",
  "option": {
    "color": {
      "$type": "color",
      "white": { "$value": "oklch(1 0 0)" },
      "gray": {
        "50": { "$value": "oklch(0.97 0.004 255)" },
        "200": { "$value": "oklch(0.88 0.008 255)" },
        "600": { "$value": "oklch(0.48 0.015 255)" },
        "900": { "$value": "oklch(0.22 0.015 255)" }
      },
      "blue": { "600": { "$value": "oklch(0.55 0.18 255)" } },
      "purple": { "600": { "$value": "oklch(0.52 0.2 300)" } },
      "red": { "600": { "$value": "oklch(0.56 0.2 25)" } },
      "green": { "600": { "$value": "oklch(0.58 0.15 150)" } }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "ui": {
        "brand": { "$value": "{option.color.blue.600}" },
        "action": { "$value": "{option.color.purple.600}" },
        "danger": { "$value": "{option.color.red.600}" },
        "success": { "$value": "{option.color.green.600}" },
        "border": { "$value": "{option.color.gray.200}" }
      },
      "ink": {
        "base": { "$value": "{option.color.gray.900}" },
        "muted": { "$value": "{option.color.gray.600}" }
      },
      "surface": {
        "0": { "$value": "{option.color.white}" },
        "1": { "$value": "{option.color.gray.50}" }
      }
    }
  }
}
