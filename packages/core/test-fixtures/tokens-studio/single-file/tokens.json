{
  "core": {
    "color": {
      "white": {
        "$type": "color",
        "$value": "#ffffff"
      },
      "black": {
        "$type": "color",
        "$value": "#000000"
      },
      "gray": {
        "50": {
          "$type": "color",
          "$value": "#f8fafc"
        },
        "200": {
          "$type": "color",
          "$value": "#e2e8f0"
        },
        "600": {
          "$type": "color",
          "$value": "#475569"
        },
        "700": {
          "$type": "color",
          "$value": "#334155"
        },
        "800": {
          "$type": "color",
          "$value": "#1e293b"
        },
        "900": {
          "$type": "color",
          "$value": "#0f172a"
        }
      },
      "blue": {
        "400": {
          "$type": "color",
          "$value": "#60a5fa"
        },
        "600": {
          "$type": "color",
          "$value": "#2563eb"
        }
      },
      "red": {
        "600": {
          "$type": "color",
          "$value": "#dc2626"
        }
      }
    },
    "space": {
      "base": {
        "$type": "spacing",
        "$value": "4"
      },
      "md": {
        "$type": "spacing",
        "$value": "{space.base} * 4"
      }
    },
    "radius": {
      "sm": {
        "$type": "borderRadius",
        "$value": "4"
      },
      "md": {
        "$type": "borderRadius",
        "$value": "roundTo({radius.sm} * 1.75)"
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamilies",
          "$value": "Inter, system-ui, sans-serif"
        }
      },
      "size": {
        "base": {
          "$type": "fontSizes",
          "$value": "16"
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeights",
          "$value": "Regular"
        },
        "semibold": {
          "$type": "fontWeights",
          "$value": "Semi Bold"
        }
      },
      "line-height": {
        "$type": "lineHeights",
        "$value": "150%"
      },
      "tracking": {
        "tight": {
          "$type": "letterSpacing",
          "$value": "-2%"
        }
      }
    },
    "opacity": {
      "disabled": {
        "$type": "opacity",
        "$value": "50%"
      }
    },
    "shadow": {
      "md": {
        "$type": "boxShadow",
        "$value": {
          "x": "0",
          "y": "4",
          "blur": "8",
          "spread": "0",
          "color": "rgba({color.black}, 0.2)",
          "type": "dropShadow"
        }
      }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontWeight": "{font.weight.regular}",
          "fontSize": "{font.size.base}",
          "lineHeight": "{font.line-height}",
          "letterSpacing": "0"
        }
      }
    }
  },
  "semantic/light": {
    "color": {
      "bg": {
        "default": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "subtle": {
          "$type": "color",
          "$value": "{color.gray.50}"
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "{color.gray.900}"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.gray.600}"
        }
      },
      "line": {
        "default": {
          "$type": "color",
          "$value": "{color.gray.200}"
        }
      },
      "action": {
        "default": {
          "$type": "color",
          "$value": "{color.blue.600.value}"
        }
      },
      "backdrop": {
        "$type": "color",
        "$value": "rgba({color.black}, 0.5)"
      }
    }
  },
  "semantic/dark": {
    "color": {
      "bg": {
        "default": {
          "$type": "color",
          "$value": "{color.gray.900}"
        },
        "subtle": {
          "$type": "color",
          "$value": "{color.gray.800}"
        }
      },
      "fg": {
        "default": {
          "$type": "color",
          "$value": "{color.white}"
        },
        "muted": {
          "$type": "color",
          "$value": "{color.gray.200}"
        }
      },
      "line": {
        "default": {
          "$type": "color",
          "$value": "{color.gray.700}"
        }
      },
      "action": {
        "default": {
          "$type": "color",
          "$value": "{color.blue.400}"
        }
      },
      "backdrop": {
        "$type": "color",
        "$value": "rgba({color.black}, 0.7)"
      }
    }
  },
  "$themes": [
    {
      "id": "6f1c2a0e-light",
      "name": "Light",
      "group": "Mode",
      "selectedTokenSets": {
        "core": "source",
        "semantic/light": "enabled",
        "semantic/dark": "disabled"
      },
      "$figmaCollectionId": "VariableCollectionId:1:1",
      "$figmaModeId": "1:0"
    },
    {
      "id": "6f1c2a0e-dark",
      "name": "Dark",
      "group": "Mode",
      "selectedTokenSets": {
        "core": "source",
        "semantic/light": "disabled",
        "semantic/dark": "enabled"
      },
      "$figmaCollectionId": "VariableCollectionId:1:1",
      "$figmaModeId": "1:1"
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "semantic/light",
      "semantic/dark"
    ]
  }
}
