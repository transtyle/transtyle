{
  "color": {
    "white": {
      "value": "#ffffff",
      "type": "color"
    },
    "black": {
      "value": "#000000",
      "type": "color"
    },
    "gray": {
      "50": {
        "value": "#f8fafc",
        "type": "color"
      },
      "200": {
        "value": "#e2e8f0",
        "type": "color"
      },
      "600": {
        "value": "#475569",
        "type": "color"
      },
      "700": {
        "value": "#334155",
        "type": "color"
      },
      "800": {
        "value": "#1e293b",
        "type": "color"
      },
      "900": {
        "value": "#0f172a",
        "type": "color"
      }
    },
    "blue": {
      "400": {
        "value": "#60a5fa",
        "type": "color"
      },
      "600": {
        "value": "#2563eb",
        "type": "color"
      }
    },
    "red": {
      "600": {
        "value": "#dc2626",
        "type": "color"
      }
    }
  },
  "space": {
    "base": {
      "value": "4",
      "type": "spacing"
    },
    "md": {
      "value": "{space.base.value} * 4",
      "type": "spacing"
    }
  },
  "radius": {
    "sm": {
      "value": "4",
      "type": "borderRadius"
    },
    "md": {
      "value": "roundTo({radius.sm.value} * 1.75)",
      "type": "borderRadius"
    }
  },
  "font": {
    "family": {
      "sans": {
        "value": "Inter, system-ui, sans-serif",
        "type": "fontFamilies"
      }
    },
    "size": {
      "base": {
        "value": "16",
        "type": "fontSizes"
      }
    },
    "weight": {
      "regular": {
        "value": "Regular",
        "type": "fontWeights"
      },
      "semibold": {
        "value": "Semi Bold",
        "type": "fontWeights"
      }
    },
    "line-height": {
      "value": "150%",
      "type": "lineHeights"
    },
    "tracking": {
      "tight": {
        "value": "-2%",
        "type": "letterSpacing"
      }
    }
  },
  "opacity": {
    "disabled": {
      "value": "50%",
      "type": "opacity"
    }
  },
  "shadow": {
    "md": {
      "value": {
        "x": "0",
        "y": "4",
        "blur": "8",
        "spread": "0",
        "color": "rgba({color.black.value}, 0.2)",
        "type": "dropShadow"
      },
      "type": "boxShadow"
    }
  },
  "typography": {
    "body": {
      "value": {
        "fontFamily": "{font.family.sans.value}",
        "fontWeight": "{font.weight.regular.value}",
        "fontSize": "{font.size.base.value}",
        "lineHeight": "{font.line-height.value}",
        "letterSpacing": "0"
      },
      "type": "typography"
    }
  }
}
