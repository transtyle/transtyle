{
  "$schema": "https://transtyle.dev/schemas/mapping/v0.json",
  "name": "ourlib",
  "files": [
    {
      "path": "ourlib.css",
      "template": "css-custom-properties",
      "header": ["/* ourlib theme for {projectName}: generated by transtyle, do not edit */"],
      "blocks": [{ "mode": { "color-scheme": "dark" }, "selector": ".ourlib-dark" }],
      "rows": [
        { "variable": "--ourlib-brand", "slot": "semantic.color.primary.solid" },
        { "variable": "--ourlib-brand-hover", "slot": "semantic.color.primary.solid-hover" },
        { "variable": "--ourlib-on-brand", "slot": "semantic.color.primary.on-solid" },
        { "variable": "--ourlib-surface", "slot": "semantic.color.elevation.0.surface" },
        { "variable": "--ourlib-text", "slot": "semantic.color.text.base" },
        { "variable": "--ourlib-radius", "slot": "semantic.radius.md" },
        { "variable": "--ourlib-font", "slot": "semantic.type.role.body.md", "part": "fontFamily" }
      ]
    },
    {
      "path": "_ourlib.scss",
      "template": "scss-variables",
      "header": ["// ourlib Sass variables for {projectName}: generated by transtyle"],
      "rows": [
        { "variable": "$ourlib-brand", "slot": "semantic.color.primary.solid", "format": "hex" },
        { "variable": "$ourlib-radius", "slot": "semantic.radius.md" }
      ]
    }
  ]
}
