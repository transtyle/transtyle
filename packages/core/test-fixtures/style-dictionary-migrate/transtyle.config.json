{
  "$schema": "https://transtyle.dev/schemas/config/v0.json",
  "name": "style-dictionary-migrate-fixture",
  "tokens": ["tokens/*.json"],
  "modes": {
    "color-scheme": { "values": ["light"], "default": "light" }
  },
  "derivation": { "rules": "standard@1", "autoDark": false },
  "targets": {
    "css-variables": { "output": "dist/css-variables" }
  }
}
