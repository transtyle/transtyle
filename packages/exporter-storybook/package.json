{
  "name": "@transtyle/exporter-storybook",
  "version": "0.1.0-alpha.2",
  "description": "Transtyle exporter for Storybook chrome theming and preview composition (SB 8–9).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@transtyle/ir": "0.1.0-alpha.2"
  },
  "transtyle": {
    "kind": "exporter",
    "name": "storybook",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": {
      "storybook": [
        ">=8 <10"
      ]
    },
    "modes": [
      "color-scheme"
    ],
    "capabilities": [
      "build",
      "compose"
    ]
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transtyle/transtyle.git",
    "directory": "packages/exporter-storybook"
  },
  "homepage": "https://transtyle.github.io/transtyle/docs/exporter-storybook/",
  "bugs": "https://github.com/transtyle/transtyle/issues",
  "license": "MIT"
}
