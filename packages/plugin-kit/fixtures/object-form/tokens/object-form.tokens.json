{
  "semantic": {
    "color": {
      "primary": { "solid": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.23, 0.36, 0.86], "alpha": 1, "hex": "#3b5bdb" } } },
      "danger": { "solid": { "$type": "color", "$value": { "colorSpace": "display-p3", "components": [0.85, 0.1, 0.12] } } },
      "elevation": {
        "0": {
          "surface": {
            "$type": "color",
            "$value": { "colorSpace": "srgb", "components": [1, 1, 1] },
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": { "colorSpace": "oklch", "components": [0.17, 0.006, 270] } } } }
          }
        }
      },
      "text": {
        "base": {
          "$type": "color",
          "$value": "#212529",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#f8f9fa" } } }
        }
      }
    },
    "radius": { "md": { "$type": "dimension", "$value": { "value": 0.375, "unit": "rem" } } },
    "space": {
      "4": {
        "$value": { "value": 16, "unit": "px" },
        "$extensions": { "transtyle.modes": { "density": { "compact": { "value": 12, "unit": "px" } } } }
      },
      "$type": "dimension",
      "px": { "$value": { "value": 1e-7, "unit": "rem" } }
    },
    "border": { "$type": "dimension", "radius-alias": { "$value": "{semantic.radius.md}" } },
    "duration": { "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } } },
    "easing": { "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] } },
    "font": { "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] } },
    "type": {
      "weight": { "semibold": { "$type": "fontWeight", "$value": "semi-bold" } },
      "role": {
        "body": {
          "md": {
            "$type": "typography",
            "$value": {
              "fontFamily": "Inter",
              "fontSize": { "value": 1, "unit": "rem" },
              "fontWeight": "light",
              "lineHeight": 1.5,
              "letterSpacing": { "value": 0.5, "unit": "px" }
            }
          }
        }
      }
    }
  }
}
