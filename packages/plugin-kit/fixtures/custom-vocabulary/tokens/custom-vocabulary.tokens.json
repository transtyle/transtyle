{
  "semantic": {
    "color": {
      "primary": { "solid": { "$type": "color", "$value": "{semantic.color.brand.ink}" } },
      "elevation": {
        "0": {
          "surface": {
            "$type": "color",
            "$value": "#ffffff",
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#101114" } } }
          }
        }
      },
      "text": {
        "base": {
          "$type": "color",
          "$value": "#212529",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#f8f9fa" } } }
        }
      },
      "brand": {
        "ink": {
          "$type": "color",
          "$value": "#2b4c7e",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#8fb3ff" } } }
        },
        "highlight": { "$type": "color", "$value": "#ffd43b" }
      }
    },
    "size": { "gutter": { "$type": "dimension", "$value": "1.5rem" } },
    "effect": {
      "glow": {
        "$type": "shadow",
        "$value": {
          "color": "#2b4c7e66",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "12px",
          "spread": "2px"
        }
      }
    }
  }
}
