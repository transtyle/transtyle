{
  "semantic": {
    "color": {
      "primary": { "solid": { "$type": "color", "$value": "#3b5bdb" } },
      "elevation": {
        "0": {
          "surface": {
            "$type": "color",
            "$value": "#ffffff",
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#101114" } } }
          }
        }
      },
      "text": {
        "base": {
          "$type": "color",
          "$value": "#212529",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#f8f9fa" } } }
        }
      }
    },
    "radius": { "md": { "$type": "dimension", "$value": "0.375rem" } }
  },
  "component": {
    "control": { "radius": { "$type": "dimension", "$value": "0.25rem" } },
    "button": {
      "radius": { "$type": "dimension", "$value": "{semantic.radius.full}" },
      "padding-x": { "$type": "dimension", "$value": "1.25rem" }
    },
    "tooltip": { "max-width": { "$type": "dimension", "$value": "17rem" } }
  }
}
