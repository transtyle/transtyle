{
  "semantic": {
    "color": {
      "primary": { "solid": { "$type": "color", "$value": "#3b5bdb" } },
      "danger": { "solid": { "$type": "color", "$value": "color(display-p3 0.85 0.1 0.12)" } },
      "elevation": {
        "0": {
          "surface": {
            "$type": "color",
            "$value": "#ffffff",
            "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "oklch(0.17 0.006 270)" } } }
          }
        }
      },
      "text": {
        "base": {
          "$type": "color",
          "$value": "#212529",
          "$extensions": { "transtyle.modes": { "color-scheme": { "dark": "#f8f9fa" } } }
        }
      }
    },
    "radius": { "md": { "$type": "dimension", "$value": "0.375rem" } },
    "space": {
      "4": { "$value": "16px", "$extensions": { "transtyle.modes": { "density": { "compact": "12px" } } } },
      "$type": "dimension",
      "px": { "$value": "0.0000001rem" }
    },
    "border": { "$type": "dimension", "radius-alias": { "$value": "{semantic.radius.md}" } },
    "duration": { "fast": { "$type": "duration", "$value": "120ms" } },
    "easing": { "standard": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" } },
    "font": { "sans": { "$type": "fontFamily", "$value": "Inter, system-ui, sans-serif" } },
    "type": {
      "weight": { "semibold": { "$type": "fontWeight", "$value": 600 } },
      "role": {
        "body": {
          "md": {
            "$type": "typography",
            "$value": {
              "fontFamily": "Inter",
              "fontSize": "1rem",
              "fontWeight": 300,
              "lineHeight": 1.5,
              "letterSpacing": "0.5px"
            }
          }
        }
      }
    }
  }
}
