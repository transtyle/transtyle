{
  "name": "@transtyle/exporter-bootstrap",
  "version": "0.1.0-alpha.2",
  "description": "Transtyle exporter for Bootstrap themes (5.3+, Sass and CSS-variable paths).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@transtyle/ir": "0.1.0-alpha.2"
  },
  "transtyle": {
    "kind": "exporter",
    "name": "bootstrap",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": {
      "bootstrap": [
        ">=5.3 <6"
      ]
    },
    "modes": [
      "color-scheme"
    ],
    "capabilities": [
      "build"
    ]
  },
  "files": [
    "src",
    "surface-inventory.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transtyle/transtyle.git",
    "directory": "packages/exporter-bootstrap"
  },
  "homepage": "https://transtyle.github.io/transtyle/docs/exporter-bootstrap/",
  "bugs": "https://github.com/transtyle/transtyle/issues",
  "license": "MIT"
}
