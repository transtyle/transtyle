{
  "name": "@transtyle/exporter-bootstrap",
  "version": "0.1.0",
  "description": "Transtyle exporter for Bootstrap themes (5.3+, Sass and CSS-variable paths).",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "transtyle": {
    "kind": "exporter",
    "name": "bootstrap",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": { "bootstrap": [">=5.3 <6"] },
    "modes": ["color-scheme"],
    "capabilities": ["build"]
  },
  "license": "MIT"
}
