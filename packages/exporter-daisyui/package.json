{
  "name": "@transtyle/exporter-daisyui",
  "version": "0.1.0",
  "description": "Transtyle exporter for daisyUI themes (v5, Tailwind 4 era).",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "dependencies": { "@transtyle/ir": "*" },
  "transtyle": {
    "kind": "exporter",
    "name": "daisyui",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": { "daisyui": [">=5 <6"] },
    "modes": ["color-scheme"],
    "capabilities": ["build"]
  },
  "license": "MIT"
}
