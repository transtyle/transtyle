{
  "name": "@transtyle/exporter-daisyui",
  "version": "0.1.0-alpha.1",
  "description": "Transtyle exporter for daisyUI themes (v5, Tailwind 4 era).",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "dependencies": {
    "@transtyle/ir": "0.1.0-alpha.1"
  },
  "transtyle": {
    "kind": "exporter",
    "name": "daisyui",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": {
      "daisyui": [
        ">=5 <6"
      ]
    },
    "modes": [
      "color-scheme"
    ],
    "capabilities": [
      "build"
    ]
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transtyle/transtyle.git",
    "directory": "packages/exporter-daisyui"
  },
  "homepage": "https://transtyle.github.io/transtyle/docs/exporter-daisyui/",
  "bugs": "https://github.com/transtyle/transtyle/issues",
  "license": "MIT"
}
