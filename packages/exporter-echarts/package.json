{
  "name": "@transtyle/exporter-echarts",
  "version": "0.1.0",
  "description": "Transtyle exporter for Apache ECharts theme objects.",
  "type": "module",
  "main": "./src/index.js",
  "exports": { ".": "./src/index.js" },
  "dependencies": { "@transtyle/ir": "*" },
  "transtyle": {
    "kind": "exporter",
    "name": "echarts",
    "irSpec": "v0-draft",
    "pluginApi": "0",
    "targets": { "echarts": [">=5 <7"] },
    "modes": ["color-scheme"],
    "capabilities": ["build"]
  },
  "license": "MIT"
}
