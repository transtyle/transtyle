{
  "name": "transtyle-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Transtyle — a design system compiler. Monorepo root.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "website",
    "examples/*/demo/*"
  ],
  "scripts": {
    "example:build": "transtyle build --cwd examples/acme && transtyle build --cwd examples/cathode && transtyle build --cwd examples/govuk && transtyle build --cwd examples/carbon",
    "example:build:acme": "transtyle build --cwd examples/acme",
    "example:build:cathode": "transtyle build --cwd examples/cathode",
    "example:build:govuk": "transtyle build --cwd examples/govuk",
    "example:build:carbon": "transtyle build --cwd examples/carbon",
    "example:shadcn": "transtyle build shadcn --cwd examples/acme",
    "example:check": "transtyle check --cwd examples/acme",
    "example:check:acme": "transtyle check --cwd examples/acme",
    "example:check:cathode": "transtyle check --cwd examples/cathode",
    "example:check:govuk": "transtyle check --cwd examples/govuk",
    "example:check:carbon": "transtyle check --cwd examples/carbon",
    "changeset": "changeset",
    "check:manifests": "node scripts/check-package-manifests.mjs",
    "sync:latest-tag": "node scripts/sync-latest-tag.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "check:sync": "node scripts/check-sync.mjs && node scripts/check-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "format:md": "prettier --write \"**/*.{md,mdx}\"",
    "check:format": "prettier --check \"**/*.{md,mdx}\"",
    "gen:brand": "node scripts/gen-brand.mjs",
    "gen:social": "node scripts/gen-social-card.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "gen:figures": "node scripts/gen-figures.mjs",
    "check:figures": "node scripts/gen-figures.mjs --check",
    "gen:matrix": "node scripts/gen-matrix.mjs",
    "check:matrix": "node scripts/gen-matrix.mjs --check",
    "gen:catalog-signals": "node scripts/gen-catalog-signals.mjs",
    "check:catalog-signals": "node scripts/gen-catalog-signals.mjs --check",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "gen:reference-mapping": "node scripts/gen-reference-mapping.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:grid": "node scripts/check-grid.mjs",
    "check:rem-base": "node scripts/check-rem-base.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:atomic-emit": "node scripts/check-atomic-emit.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "check:cli": "node scripts/check-cli.mjs",
    "check:explain": "node scripts/check-explain.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:coverage-bar": "node scripts/check-coverage-bar.mjs",
    "check:gamut-rows": "node scripts/check-gamut-rows.mjs",
    "check:minimal-ds": "node scripts/check-minimal-ds.mjs",
    "check:demo-parity": "node scripts/check-demo-parity.mjs",
    "check:bootstrap-surface": "node scripts/check-bootstrap-surface.mjs",
    "check:component-tier": "node scripts/check-component-tier.mjs",
    "check:tokens-studio": "node scripts/check-tokens-studio.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "bench": "node scripts/bench.mjs",
    "check:all": "npm run check:sync && npm run check:demos && npm run check:manifests && npm run check:brand && npm run check:figures && npm run check:matrix && npm run check:catalog-signals && npm run check:doc-numbers && npm run check:encoding && npm run check:format && npm run check:color && npm run check:plugins && npm run check:grid && npm run check:rem-base && npm run check:fixtures && npm run check:determinism && npm run check:atomic-emit && npm run check:browser && npm run check:schemas && npm run check:cli && npm run check:explain && npm run check:component-tier && npm run check:tokens-studio && npm run check:bootstrap-surface && npm run check:coverage-bar && npm run check:gamut-rows && npm run check:minimal-ds && npm run check:demo-parity",
    "presite:build": "npm run check:sync && npm run check:doc-numbers",
    "postsite:build": "npm run check:site-links",
    "check:site-links": "node scripts/check-site-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "site:dev": "npm run dev -w @transtyle/website",
    "site:build": "npm run build -w @transtyle/website",
    "site:preview": "npm run preview -w @transtyle/website",
    "demos:build": "node scripts/build-demos.mjs",
    "demos:assemble": "node scripts/assemble-demos.mjs",
    "demos:all": "npm run site:build && npm run demos:build && npm run demos:assemble",
    "check:demos": "node scripts/check-demos.mjs",
    "check:plugins": "node scripts/check-plugins.mjs",
    "check:color": "node scripts/check-color.mjs",
    "check:doc-numbers": "node scripts/check-doc-numbers.mjs",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transtyle/transtyle.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-wasm": "2.6.2",
    "apca-w3": "0.1.9",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "satori": "0.33.4"
  }
}
