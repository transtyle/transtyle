---
import BlogPostLayout from '@deramond.dev/astro/layouts/BlogPostLayout.astro';
import '../../styles/global.css';
import { posts, postPath, formatDate } from '../../blog.js';
import { withBase } from '../../url.js';

// A post is @deramond.dev/astro's BlogPostLayout: the site header and footer,
// the centred head (breadcrumb, date, title, lead, meta row), the text and
// figure columns, the table of contents and the schema.org data. It renders
// through the package's SiteLayout, so it doesn't go through Base.astro; what
// Base gives every other page goes in the layout's slots: the RSS link, the
// header's GitHub link, the alpha notice (as the docs pages show it) and the
// Markdown link. The author is the brand author the integration already knows.

export async function getStaticPaths() {
  const mods = import.meta.glob('../../blog/*.md', { eager: true });
  return Object.keys(mods).map((p) => ({ params: { slug: p.split('/').pop().replace('.md', '') } }));
}

const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);
const { Content } = post.mod;
const older = posts.filter((p) => p.date < post.date).slice(0, 2);
---

<BlogPostLayout
  title={post.title}
  description={post.description}
  date={post.date}
  image={withBase(`/og/blog-${slug}.png`)}
  headings={post.mod.getHeadings()}
  index={{ label: 'Blog', href: withBase('/blog/') }}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Transtyle blog" href={withBase('/blog/rss.xml')} />
  <a slot="actions" class="gh" href="https://github.com/transtyle/transtyle" rel="noopener">GitHub</a>
  <p slot="before" class="alpha-note">
    <strong>Alpha</strong> — breaking changes ship without a deprecation cycle.
    <a href={withBase('/docs/roadmap/')}>What is built vs. planned</a>
  </p>
  <a slot="meta" href={withBase(`/blog/${slug}.md`)} title="This post as raw markdown">Markdown</a>

  <Content />

  <div slot="after" class="post-foot">
    <p>
      Transtyle is open source (MIT) and pre-1.0. If this post got something wrong, or if your
      design system breaks it, that is the most useful thing you can send us —
      <a href="https://github.com/transtyle/transtyle" rel="noopener">the repository</a> is where that
      conversation happens.
    </p>
    {
      older.length > 0 && (
        <ul class="more-posts">
          {older.map((p) => (
            <li>
              <a href={postPath(p.slug)}>{p.title}</a>
              <time datetime={p.date}>{formatDate(p.date)}</time>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BlogPostLayout>

<style>
  /* Base.astro's header link and the docs pages' alpha note, on a post. */
  .gh { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); }
  .gh:hover { color: var(--color-fg); }
  .alpha-note { margin: 0 0 var(--space-4); font-size: 0.85rem; color: var(--color-muted); }
  .alpha-note strong { color: var(--color-warning); }
  /* At 17 px on a phone, a long slash-joined word in the post
     (native/derived/approximated/dropped/unsupported) is wider than the text
     column and pushed the page sideways: it breaks instead, and only when it
     can't fit on a line of its own. */
  :global(.d-article .d-prose) { overflow-wrap: break-word; }
  .post-foot { border-top: var(--stroke-hairline) solid var(--color-line); padding-top: 22px; font-size: 0.9rem; color: var(--color-muted); }
  .more-posts { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .more-posts time { font-size: 0.78rem; margin-left: 0.6rem; }
</style>
