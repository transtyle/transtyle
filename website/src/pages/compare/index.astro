    /* ---------- reading guide ---------- */
    .band { padding: 2.4rem 0; }
    .band h2 { font-size: 1.4rem; letter-spacing: -0.02em; margin: 0 0 1rem; font-weight: 700; }
    .reads { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
