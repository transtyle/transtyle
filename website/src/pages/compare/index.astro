    .pane iframe { flex: 1; width: 100%; border: 0; display: block; background: #fff; }

    .handle { background: var(--border-soft); cursor: col-resize; display: flex; align-items: center; justify-content: center; touch-action: none; }
    .handle:hover, .handle:focus-visible { background: var(--primary); outline: none; }
