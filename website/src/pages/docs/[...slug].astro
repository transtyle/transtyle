---
import Base from '../../layouts/Base.astro';
import { sections, orderedSlugs, docPath } from '../../nav.js';

export async function getStaticPaths() {
  const mods = import.meta.glob('../../docs/*.md', { eager: true });
  return Object.keys(mods).map((p) => {
    const slug = p.split('/').pop().replace('.md', '');
    return { params: { slug: slug === 'index' ? undefined : slug } };
  });
}

const mods = import.meta.glob('../../docs/*.md', { eager: true });
const pages = Object.fromEntries(
  Object.entries(mods).map(([p, m]) => [p.split('/').pop().replace('.md', ''), m]),
);

const slug = Astro.params.slug ?? 'index';
const page = pages[slug];
const { Content, frontmatter } = page;
const mdHref = `/docs/${slug}.md`;

const headings = page.getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
const i = orderedSlugs.indexOf(slug);
const prev = i > 0 ? orderedSlugs[i - 1] : null;
const next = i < orderedSlugs.length - 1 ? orderedSlugs[i + 1] : null;
---
<Base title={`${frontmatter.title} · Transtyle docs`} description={frontmatter.description} current="docs">
  <div class="docs-layout">
    <nav class="sidebar" aria-label="Documentation">
      {sections.map((section) => (
        <div class="nav-section">
          <div class="nav-title">{section.title}</div>
          {section.slugs.map((s) => (
            <a class:list={['nav-link', { active: s === slug }]} href={docPath(s)} aria-current={s === slug ? 'page' : undefined}>
              {pages[s].frontmatter.title}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <main class="prose" id="main">
      <div class="page-tools">
        <a href={mdHref} title="This page as raw markdown — for humans with taste and agents with context windows">View as Markdown</a>
      </div>
      <Content />
      <nav class="pager" aria-label="Previous and next page">
        {prev ? (
          <a class="pager-link prev" href={docPath(prev)}>
            <span class="pager-label">← Previous</span>
            <span class="pager-title">{pages[prev].frontmatter.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pager-link next" href={docPath(next)}>
            <span class="pager-label">Next →</span>
            <span class="pager-title">{pages[next].frontmatter.title}</span>
          </a>
        ) : <span />}
      </nav>
    </main>
    {headings.length > 1 && (
      <aside class="toc" aria-label="On this page">
        <div class="toc-title">On this page</div>
        {headings.map((h) => (
          <a class:list={['toc-link', `depth-${h.depth}`]} href={`#${h.slug}`}>{h.text}</a>
        ))}
      </aside>
    )}
  </div>

  <script>
    // Scrollspy: highlight the TOC entry of the last heading above the
    // reading line (25% down the viewport). Plain scroll listener — cheap at
    // this page size and immune to IntersectionObserver throttling quirks.
    const links = [...document.querySelectorAll('.toc-link')];
    const targets = links
      .map((a) => [document.getElementById(decodeURIComponent(a.hash.slice(1))), a])
      .filter(([h]) => h);
    if (targets.length) {
      let active = null;
      const update = () => {
        const line = window.scrollY + window.innerHeight * 0.25;
        let current = targets[0][1];
        for (const [h, a] of targets) if (h.offsetTop <= line) current = a;
        if (current !== active) {
          active?.classList.remove('active');
          active = current;
          current.classList.add('active');
        }
      };
      addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>

  <style>
    .docs-layout { display: flex; max-width: 86rem; margin: 0 auto; padding: 0 clamp(1rem, 3vw, 2rem); gap: 3rem; }
    .sidebar {
      width: 15rem; flex-shrink: 0; padding: 1.6rem 0;
      position: sticky; top: 3.4rem; height: calc(100vh - 3.4rem); overflow-y: auto;
      border-right: 1px solid var(--border-soft);
    }
    .nav-title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-muted); margin: 1.3rem 0 0.35rem; font-weight: 650; }
    .nav-section:first-child .nav-title { margin-top: 0; }
    .nav-link { display: block; padding: 0.24rem 0.7rem; margin-right: 0.8rem; border-radius: 7px; color: var(--text); font-size: 0.9rem; }
    .nav-link:hover { background: var(--bg-soft); text-decoration: none; }
    .nav-link.active { background: var(--primary-soft); color: var(--primary-strong); font-weight: 600; }
    main { padding: 1.8rem 0 3rem; flex: 1; }
    .page-tools { display: flex; justify-content: flex-end; font-size: 0.8rem; margin-bottom: -0.6rem; }
    .page-tools a { color: var(--text-muted); }

    .toc {
      width: 13rem; flex-shrink: 0; padding: 2.2rem 0 1rem;
      position: sticky; top: 3.4rem; height: calc(100vh - 3.4rem); overflow-y: auto;
      font-size: 0.82rem;
    }
    .toc-title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-muted); font-weight: 650; margin-bottom: 0.5rem; }
    .toc-link { display: block; padding: 0.18rem 0 0.18rem 0.7rem; color: var(--text-muted); border-left: 2px solid var(--border-soft); }
    .toc-link.depth-3 { padding-left: 1.6rem; }
    .toc-link:hover { color: var(--text); text-decoration: none; }
    .toc-link.active { color: var(--primary-strong); border-left-color: var(--primary); }

    .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--border-soft); }
    .pager-link { display: flex; flex-direction: column; gap: 0.15rem; padding: 0.7rem 1rem; border: 1px solid var(--border); border-radius: 10px; max-width: 48%; }
    .pager-link:hover { text-decoration: none; border-color: var(--primary); background: var(--bg-soft); }
    .pager-link.next { margin-left: auto; text-align: right; }
    .pager-label { font-size: 0.75rem; color: var(--text-muted); }
    .pager-title { font-weight: 600; font-size: 0.92rem; }

    @media (max-width: 1180px) {
      .toc { display: none; }
    }
    @media (max-width: 820px) {
      .docs-layout { flex-direction: column; gap: 0; }
      .sidebar { position: static; width: auto; height: auto; border-right: none; border-bottom: 1px solid var(--border-soft); }
    }
  </style>
</Base>
