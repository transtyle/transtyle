---
import { DocsLayout } from '@deramond.dev/astro';
import '../../styles/global.css';
import { sections, orderedSlugs, docPath } from '../../nav.js';
import { withBase } from '../../url.js';

// The docs shell (top bar, numbered sidebar, table of contents, previous/next,
// search) is @deramond.dev/astro's DocsLayout. What it shows stays this site's
// own: the pages are src/docs/*.md, and the sidebar and the page order are
// src/nav.js — the single source check-docs.mjs, llms.txt and the raw-markdown
// twins read too.

export async function getStaticPaths() {
  const mods = import.meta.glob('../../docs/*.md', { eager: true });
  return Object.keys(mods).map((p) => {
    const slug = p.split('/').pop().replace('.md', '');
    return { params: { slug: slug === 'index' ? undefined : slug } };
  });
}

const mods = import.meta.glob('../../docs/*.md', { eager: true });
const pages = Object.fromEntries(
  Object.entries(mods).map(([p, m]) => [p.split('/').pop().replace('.md', ''), m]),
);

const slug = Astro.params.slug ?? 'index';
const page = pages[slug];
const { Content, frontmatter } = page;
const mdHref = withBase(`/docs/${slug}.md`);

const link = (s) => ({ label: pages[s].frontmatter.title, href: docPath(s) });
const sidebar = sections.map((section) => ({ label: section.title, items: section.slugs.map(link) }));
const i = orderedSlugs.indexOf(slug);
const prev = i > 0 ? link(orderedSlugs[i - 1]) : undefined;
const next = i < orderedSlugs.length - 1 ? link(orderedSlugs[i + 1]) : undefined;
---
<DocsLayout
  title={`${frontmatter.title} · Transtyle docs`}
  rawTitle
  description={frontmatter.description}
  image={withBase(`/og/docs-${slug}.png`)}
  sidebar={sidebar}
  headings={page.getHeadings()}
  prev={prev}
  next={next}
  editUrl={`https://github.com/transtyle/transtyle/edit/main/website/src/docs/${slug}.md`}
  pageCount={orderedSlugs.length}
>
  <Fragment slot="links">
    <a href={mdHref} title="This page as raw markdown — for humans with taste and agents with context windows">Markdown</a>
    <a href="https://github.com/transtyle/transtyle" rel="noopener">GitHub</a>
  </Fragment>
  <p slot="before" class="alpha-note">
    <strong>Alpha</strong> — breaking changes ship without a deprecation cycle.
    <a href={withBase('/docs/roadmap/')}>What is built vs. planned</a>
  </p>
  <Content />
</DocsLayout>

<style>
  .alpha-note { margin: 0 0 var(--space-4); font-size: 0.85rem; color: var(--color-muted); }
  .alpha-note strong { color: var(--color-warning); }
  /* Each page brings its own h1 in the markdown: sized as the shell's title. */
  :global(.d-prose h1) { font-size: clamp(2rem, 3.6vw, 3.25rem); margin-bottom: 12px; }
</style>
