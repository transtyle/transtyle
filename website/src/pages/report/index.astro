    .r-head { padding: var(--space-6) 0 var(--space-2); }
    .r-head h2 { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-3); margin: 0 0 var(--space-4); }
    .r-head h2 code { font-size: 0.8em; font-weight: var(--font-weight-medium); background: none; border: 0; padding: 0; color: var(--color-primary); }
    .r-kicker { font: var(--type-eyebrow); letter-spacing: var(--type-eyebrow-letter-spacing); color: var(--color-muted); }
    .r-meta { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-8); margin: 0; font-size: var(--font-size-md); }
    .r-meta dt { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); margin: 0 0 var(--space-1); }
    .r-meta dd { margin: 0; min-width: 0; }
    .r-files summary { cursor: pointer; color: var(--color-primary); }
    .r-files ul { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: var(--space-1); }

