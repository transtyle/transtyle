    .r-note { margin: 0 0 var(--space-4); font-size: var(--font-size-sm); color: var(--color-muted); max-width: 46rem; }
    .r-empty { color: var(--color-fg-reading); margin: 0; }

    .r-bar.covmatrix { margin: var(--space-4) 0; }
    .r-bar .cm-row { grid-template-columns: minmax(0, 8.5rem) 1fr; }
    .r-bar .cm-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .r-counts { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; gap: var(--space-1); max-width: 46rem; }
    .r-counts li { display: grid; grid-template-columns: 10px 7.5rem 3.5rem 3rem 1fr; gap: var(--space-3); align-items: baseline; font-size: var(--font-size-md); }
    .r-counts i { width: 10px; height: 10px; border-radius: var(--radius-sm); }
    .r-counts i.native { background: var(--cov-native); }
    .r-counts i.derived { background: var(--cov-derived); }
    .r-counts i.approx { background: var(--cov-approx); }
    .r-counts i.other { background: color-mix(in oklch, var(--color-muted) 45%, transparent); }
    .r-cls { font-family: var(--font-family-mono); }
    .r-counts b, .r-pct { font-family: var(--font-family-mono); font-weight: var(--font-weight-medium); text-align: right; font-variant-numeric: tabular-nums; }
    .r-pct { color: var(--color-muted); }
    .r-blurb { color: var(--color-muted); font-size: var(--font-size-sm); }
    .r-cli { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); margin: 0 0 var(--space-3); font-size: var(--font-size-sm); }
    .r-cli span { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); }
    .r-cli code { white-space: pre-wrap; }

    .r-diags { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .r-diag { border: var(--stroke-hairline) solid var(--color-line); border-left: 3px solid var(--color-line); padding: var(--space-3) var(--space-4); background: var(--color-panel); }
    .r-diag.sev-error { border-left-color: var(--color-danger); }
    .r-diag.sev-warning { border-left-color: var(--color-warning); }
    .r-diag.sev-info { border-left-color: var(--color-primary); }
    .r-diag p { margin: 0; }
    .d-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); margin-bottom: var(--space-2) !important; }
    .r-diag .sev { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); text-transform: uppercase; }
    .sev-error .sev { color: var(--color-danger); }
    .sev-warning .sev { color: var(--color-warning); }
    .sev-info .sev { color: var(--color-primary); }
    .d-code { font-family: var(--font-family-mono); font-weight: var(--font-weight-medium); }
    .d-msg { color: var(--color-fg); overflow-wrap: anywhere; }
    .d-hint { color: var(--color-fg-reading); font-size: var(--font-size-md); margin-top: var(--space-1) !important; padding-left: var(--space-4); }
    .d-reason { margin-top: var(--space-2) !important; font-size: var(--font-size-md); color: var(--color-fg-reading); }
    .d-reason span { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); }

    /* ---- rows ---- */
    .r-filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-3) var(--space-6); margin: 0 0 var(--space-4); }
    .r-filters[hidden] { display: none; }
    .r-seg { border: 0; margin: 0; padding: 0; min-width: 0; }
    .r-seg legend { padding: 0; margin-bottom: var(--space-2); }
    .r-seg { display: flex; flex-wrap: wrap; }
    .r-seg label { position: relative; }
    .r-seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
    .r-seg span {
      display: inline-flex; align-items: baseline; gap: var(--space-2); min-height: var(--size-control); align-items: center;
      padding: 0 var(--space-3); font-family: var(--font-family-mono); font-size: var(--font-size-sm);
      border: var(--stroke-hairline) solid var(--color-line); margin: 0 -1px -1px 0; color: var(--color-fg-reading); background: var(--color-bg);
    }
    .r-seg small { color: var(--color-muted); font-size: var(--font-size-xs); }
    .r-seg input:checked + span { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); position: relative; z-index: 1; }
    .r-seg input:checked + span small { color: var(--color-on-primary); }
    .r-seg input:focus-visible + span { outline: var(--stroke-ui) solid var(--color-primary); outline-offset: 2px; position: relative; z-index: 2; }
    .r-search { display: flex; flex-direction: column; gap: var(--space-2); flex: 1 1 14rem; max-width: 22rem; }
    .r-status { margin: 0; font-size: var(--font-size-sm); color: var(--color-muted); flex-basis: 100%; }

    .r-table-wrap { border: var(--stroke-hairline) solid var(--color-line); }
    .r-table { margin: 0; font-size: var(--font-size-sm); table-layout: fixed; }
    .r-table thead th:nth-child(1) { width: 26%; }
    .r-table thead th:nth-child(2) { width: 8.5rem; }
    .r-table thead th:nth-child(3) { width: 8rem; }
    .r-table thead th:nth-child(4) { width: 28%; }
    .r-table thead th { position: sticky; top: 0; background: var(--color-bg); z-index: 1; }
    .r-table tbody th { text-align: left; font: inherit; text-transform: none; letter-spacing: normal; color: var(--color-fg); padding: var(--space-3); border-bottom: var(--stroke-hairline) solid var(--color-line); vertical-align: top; }
    .r-table tr[hidden] { display: none; }
    .r-table tr { scroll-margin-top: var(--space-12); }
    .r-table tr:target > * { background: var(--color-tint); }
    .r-table td { overflow-wrap: anywhere; }
    .r-table tbody th { overflow-wrap: anywhere; }
    .r-table code { font-size: 0.92em; }
    .trace summary { cursor: pointer; }
    .trace summary::marker { color: var(--color-muted); }
    .trace p { margin: var(--space-2) 0 var(--space-1); font-size: var(--font-size-xs); color: var(--color-muted); }
    .trace .cmd { display: block; user-select: all; white-space: pre-wrap; padding: var(--space-2); }
    .r-sub { display: block; margin-top: var(--space-1); color: var(--color-muted); font-size: var(--font-size-xs); }
    .r-none { color: var(--color-muted); font-size: var(--font-size-xs); }
    .r-dep { display: block; margin-bottom: var(--space-1); color: var(--color-fg-reading); }
    .r-desc { color: var(--color-fg-reading); font-size: var(--font-size-sm); }
    /* The site's chips are the coverage trio; the rest of the classes and
       provenance words are grey, and every chip carries its word. */
    .prov.other, .prov.aliased, .prov.defaulted { background: color-mix(in oklch, var(--color-muted) 18%, transparent); color: var(--color-fg-reading); }

    .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

    /* A phone: each row becomes a card, every cell labelled. */
    @media (max-width: 760px) {
      .r-counts li { grid-template-columns: 10px 7rem 3rem 2.5rem; }
      .r-blurb { display: none; }
      .r-table-wrap { border: 0; }
      .r-table, .r-table tbody, .r-table tr, .r-table th, .r-table td { display: block; width: 100%; }
      .r-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
      .r-table tr { border: var(--stroke-hairline) solid var(--color-line); margin: 0 0 var(--space-3); background: var(--color-panel); }
      /* Class and provenance side by side; the rest full width. */
      .r-table tbody tr:not([hidden]) { display: grid; grid-template-columns: 1fr 1fr; }
      .r-table tbody th, .r-table td[data-label='Slot'], .r-table td[data-label='Note'] { grid-column: 1 / -1; }
      .r-table tbody th, .r-table td { border: 0; padding: var(--space-2) var(--space-3); }
      .r-table tbody th { min-width: 0; border-bottom: var(--stroke-hairline) solid var(--color-line); }
      .r-table td::before { content: attr(data-label); display: block; font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); margin-bottom: var(--space-1); }
      .r-table td:empty { display: none; }
    }
  </style>
</Base>
