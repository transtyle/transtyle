---
import { codeProps } from '@deramond.dev/astro/code';
import Button from '@deramond.dev/astro/components/Button.astro';
import Base from '../layouts/Base.astro';
import { Code } from 'astro:components';
import { withBase } from '../url.js';
import { EXAMPLES, TARGETS, discoverDemos, repoRoot } from '../../../scripts/lib/demos.mjs';
import { demoThemes } from '../demo-themes.js';
import { parseColor, contrastRatio } from '../../../packages/core/src/color.js';

// The markdown pipeline's code theme (set by @deramond.dev/astro), so
// highlighted code looks identical on the homepage and in the docs.
const shiki = codeProps;

const root = repoRoot();
const demoCount = discoverDemos(root).length;
const themes = await demoThemes(EXAMPLES, root);

// The coverage bar and the contrast claim are read from the compile of
// examples/acme (shadcn), never typed: a change to Acme moves them, and the
// hero transcript below is held to the same compile by check:doc-numbers.
const acmeLight = themes.acme.light;
const cov = themes.acme.coverage.shadcn;
const covCount = (k) => cov.counts[k] ?? 0;
const covPct = (k) => (covCount(k) / cov.total) * 100;
const covOther = covCount('dropped') + covCount('unsupported');
const covOtherPct = (covOther / cov.total) * 100;
const primaryContrast = contrastRatio(parseColor(acmeLight.primary), parseColor(acmeLight.onPrimary)).toFixed(1);

// Each showcase preview wears its own target's surface, so its colours are
// handed over as custom properties on the frame: nothing in the .bs-*, .sc-*,
// .dy-* rules or the chart bars is typed. Bootstrap and daisyUI show the
// compiled light scheme, shadcn the compiled dark one. Dark publishes only the
// slots it overrides, so radii (the same in both modes) come from light.
const frameVars = (mode) => {
  const t = { ...acmeLight, ...themes.acme[mode] };
  return Object.entries({
    page: t.page, text: t.text, muted: t.muted, border: t.border,
    primary: t.primary, 'on-primary': t.onPrimary,
    danger: t.danger, 'on-danger': t.onDanger, 'danger-tint': t.dangerTint,
    'danger-on-tint': t.dangerOnTint, 'danger-outline': t.dangerOutline,
    radius: t.radius, 'radius-field': t.radiusField, 'radius-full': t.radiusFull,
  }).map(([k, v]) => `--p-${k}:${v}`).join(';');
};
const lightVars = frameVars('light');
const darkVars = frameVars('dark');
const chartBars = [[78, 'chart1'], [52, 'chart2'], [64, 'chart3'], [38, 'chart4'], [56, 'chart5']]
  .map(([h, k]) => `--h:${h}%;--c:${acmeLight[k]}`);

const authoredTokens = `{
  "semantic": {
    "color": {
      "primary": { "solid": { "$value": "{option.color.blue.600}" } },
      "elevation": { "0": { "surface": { "$value": "{option.color.white}" } } },
      "text": { "base": { "$value": "{option.color.gray.900}" } },
      "border": { "$value": "{option.color.gray.200}" }
    }
  }
}`;

const derivedCss = `--primary: oklch(0.55 0.18 255);
--primary-foreground: oklch(1 0 0);  /* contrast-picked, ${primaryContrast}:1 */
--accent: oklch(0.95 0.017 255);     /* brand-tinted */
--chart-1: #026fd7;                  /* hue-rotated palette */
/* …plus every hover/active state, light + dark,
   for all eight targets, from the same tokens */`;

// Expanded rather than one-lined: this card sits in a narrow column, and short
// lines beat horizontal scrolling for something meant to be read at a glance.
const showcaseTokens = `{
  "semantic": {
    "color": {
      "primary": {
        "solid": { "$value": "{option.color.blue.600}" }
      },
      "danger": {
        "solid": { "$value": "{option.color.red.600}" }
      }
    },
    "radius": {
      "md": { "$value": "0.5rem" }
    }
  }
}`;

const startCommands = `npm i -D @transtyle/cli
npx transtyle init            # config + starter tokens
npx transtyle add bootstrap   # …or shadcn, echarts, storybook, …
npx transtyle build`;
---
<Base title="Transtyle — the design system compiler" current="home">
  <main id="main">
    <section class="hero d-container">
      <p class="eyebrow">Design System Compiler</p>
      <h1>One design system.<br /><span class="grad">Every ecosystem.</span></h1>
      <p class="sub">
        Describe your design system once, as standard W3C design tokens. Transtyle compiles it into
        native, idiomatic themes for <strong>eight ecosystems today</strong> — shadcn/ui, daisyUI,
        Apache&nbsp;ECharts, Bootstrap, Storybook, Radix&nbsp;Themes, PrimeNG, and plain CSS variables.
        Deterministic. Explainable. Zero runtime.
      </p>
      <div class="cta">
        <Button variant="gold" href={withBase('/docs/getting-started/')}>Get started</Button>
        <Button variant="quiet" href={withBase('/docs/')}>Read the docs</Button>
      </div>
      <p class="hero-status">
        <span class="pill">Alpha</span> On npm as <code>@transtyle/cli@alpha</code> — published so it
        can be tried, not because it is finished. Breaking changes ship without a deprecation cycle.
      </p>
      <p class="hero-post">
        Read <a href={withBase('/blog/a-compiler-for-design-systems/')}>A compiler for design systems</a> — the
        experiment, the architecture, and what four real design systems look like coming out of it.
      </p>

      <div class="terminal">
        <div class="term-bar"><span></span><span></span><span></span><em>examples/acme</em></div>
        <pre data-copy="npx transtyle build shadcn bootstrap echarts"><code><span class="dim">$</span> npx transtyle build shadcn bootstrap echarts

shadcn     <span class="cov-n">42% native</span> · <span class="cov-d">53% derived</span> · <span class="cov-a">3% approximated</span> · 3% dropped
  ↳ dist/shadcn/globals.transtyle.css
bootstrap  ↳ dist/bootstrap/_variables.transtyle.scss
echarts    ↳ dist/echarts/theme.acme-{'{light,dark}'}.json
           ↳ report.json — provenance for every value

<span class="ok">✔ build complete — rebuilds are byte-identical</span></code></pre>
      </div>

      <p class="strip">
        <span>Deterministic — byte-identical rebuilds</span>
        <span>DTCG-native — no lock-in</span>
        <span>Zero runtime — files out, nothing in</span>
        <span>Agent-ready — JSON in, JSON out</span>
      </p>
    </section>

    <div class="d-container">
    <section class="band" aria-labelledby="h-pipeline">
      <h2 id="h-pipeline">A compiler, not a converter</h2>
      <p class="band-sub d-lead">The architecture of Babel and LLVM, applied to design systems: pluggable frontends and backends around one intermediate representation. N sources and M targets cost N+M mappings, not N×M converters.</p>
      <div class="pipeline">
        <div class="pipe-col">
          <h3>You write<span class="pipe-tag">token files · importers</span></h3>
          <div class="chip">DTCG token files</div>
          <div class="chip soon">Figma variables</div>
          <div class="chip soon">Tailwind config</div>
          <p class="pipe-note">One source of truth: your names, your values, plain JSON any token tool can read.</p>
        </div>
        <div class="pipe-arrow" aria-hidden="true">→</div>
        <div class="pipe-col ir">
          <h3>Transtyle compiles<span class="pipe-tag">one shared representation</span></h3>
          <div class="chip ir-chip">normalize · derive ·<br />validate · explain</div>
          <p class="pipe-note">Your tokens bind once to the <a href={withBase('/docs/language/')}>semantic catalog</a> — a pivot vocabulary of <em>meanings</em>, not names. Gaps are filled by deterministic rules.</p>
        </div>
        <div class="pipe-arrow" aria-hidden="true">→</div>
        <div class="pipe-col">
          <h3>You ship<span class="pipe-tag">native themes · exporters</span></h3>
          <div class="chip">shadcn/ui</div>
          <div class="chip">daisyUI</div>
          <div class="chip">Apache ECharts</div>
          <div class="chip">Bootstrap</div>
          <div class="chip">Storybook</div>
          <div class="chip">Radix Themes</div>
          <div class="chip">PrimeNG</div>
          <div class="chip">CSS variables</div>
          <p class="pipe-note">Idiomatic files per ecosystem — plus a coverage report saying how faithful each one is.</p>
        </div>
      </div>
    </section>

    <section class="band alt" aria-labelledby="h-derive">
      <h2 id="h-derive">Author three tokens — or every single one.</h2>
      <p class="band-sub d-lead">Three is not a marketing number: a brand color, a page background and a text color is a legal design system, and CI compiles exactly that one against all eight exporters on every commit. It is the floor, not the ceiling.</p>
      <p class="band-read">The derivation engine fills every slot you didn't author — hover states, on-colors, tints, dark-mode wiring, a data-viz palette — with deterministic, versioned rules. But every one of those slots is a real, addressable token: <a href={withBase('/docs/language/')}>the catalog</a> exposes the full role grids, elevation ladder, and scales, so you can pin any value — down to a single dark-mode hover state — and derivation yields to you. Authored always wins; every value knows its origin.</p>
      <div class="transform">
        <div class="t-side">
          <p class="t-label">You write <span class="prov authored">authored</span></p>
          <Code code={authoredTokens} lang="json" {...shiki} />
        </div>
        <div class="t-arrow" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </div>
        <div class="t-side">
          <p class="t-label">You get <span class="prov derived">derived</span></p>
          <Code code={derivedCss} lang="css" {...shiki} />
        </div>
      </div>
      <p class="band-foot">Ask the compiler why: <code>npx transtyle explain primary.tint</code> prints the value's full provenance chain.</p>
    </section>

    <section class="band" aria-labelledby="h-showcase">
      <h2 id="h-showcase">Same tokens. Native everywhere.</h2>
      <p class="band-sub d-lead">This is the whole product in one picture: one token definition on the left, and what each ecosystem's components look like wearing it. Not screenshots — these previews are styled with the actual compiled Acme values.</p>
      <div class="showcase">
        <div class="show-src">
          <p class="t-label mono">tokens/semantic.tokens.json</p>
          <Code code={showcaseTokens} lang="json" {...shiki} />
        </div>
        <div class="show-targets">
          <figure class="tframe">
            <figcaption>Bootstrap</figcaption>
            <div class="t-ui d-specimen" style={lightVars}>
              <span class="bs-btn">Primary</span>
              <span class="bs-btn outline">Secondary</span>
              <span class="bs-alert">Something went wrong.</span>
            </div>
          </figure>
          <figure class="tframe">
            <figcaption>shadcn/ui · dark</figcaption>
            <div class="t-ui d-specimen" style={darkVars}>
              <span class="sc-btn">Continue</span>
              <span class="sc-btn ghost">Cancel</span>
              <span class="sc-input">Email address</span>
            </div>
          </figure>
          <figure class="tframe">
            <figcaption>daisyUI</figcaption>
            <div class="t-ui d-specimen" style={lightVars}>
              <span class="dy-btn">Accept</span>
              <span class="dy-badge">error</span>
              <span class="dy-toggle" aria-hidden="true"><i></i></span>
            </div>
          </figure>
          <figure class="tframe">
            <figcaption>Apache ECharts</figcaption>
            <div class="t-ui d-specimen chart" style={lightVars} role="img" aria-label="Bar chart using the derived categorical palette">
              {chartBars.map((bar) => <i style={bar}></i>)}
            </div>
          </figure>
        </div>
      </div>
      <p class="band-foot">Those previews are a summary. The <a href={withBase('/demo/')}>{demoCount} live demos</a> are the real thing — each target's own components, in the browser, consuming only the compiled <code>dist/</code>.</p>
    </section>

    <section class="band alt" aria-labelledby="h-gallery">
      <h2 id="h-gallery">Don't take our word for it — {demoCount} of them are running</h2>
      <p class="band-sub d-lead">
        Four design systems, each compiled to all {TARGETS.length} targets and deployed. Within a
        target the page is byte-identical, so everything that changes between these columns came out
        of the compiler. The swatches below are read from a live compile at build time.
      </p>
      <div class="gallery-strip">
        {EXAMPLES.map((example) => (
          <a class="gcard" href={withBase(`/demo/${example.id}/shadcn/`)}>
            <span class="gswatch" aria-hidden="true">
              <i style={`background:${themes[example.id].light.primary}`}></i>
              <i style={`background:${themes[example.id].light.page}`}></i>
              <i style={`background:${themes[example.id].light.text}`}></i>
              <i style={`background:${themes[example.id].light.border}`}></i>
            </span>
            <span class="gname"><span class="d-dimension">{example.title}</span></span>
            <span class="gkicker">{example.kicker}</span>
          </a>
        ))}
      </div>
      <p class="band-foot">
        <Button variant="ghost" href={withBase('/demo/')}>Open the demo gallery →</Button>
      </p>
    </section>

    <section class="band" aria-labelledby="h-language">
      <h2 id="h-language">One meaning, every dialect</h2>
      <p class="band-sub d-lead">Frameworks disagree on names, not needs. The catalog slot is the <em>meaning</em>; each exporter speaks its target's dialect natively. Your <code>danger</code>, everywhere:</p>
      <div class="xlate">
        <div class="x-src"><span class="sw" style="--c:oklch(0.55 0.19 25)"></span><code>danger.solid</code></div>
        <div class="x-arrow" aria-hidden="true">→</div>
        <ul class="x-out">
          <li><code>--destructive</code><em>shadcn/ui</em></li>
          <li><code>$danger</code><em>Bootstrap Sass</em></li>
          <li><code>--color-error</code><em>daisyUI</em></li>
          <li><code>--danger-9</code><em>Radix Themes</em></li>
          <li><code>danger</code> severity<em>PrimeNG preset</em></li>
        </ul>
      </div>
      <p class="band-foot">The full pivot vocabulary is one page: <a href={withBase('/docs/language/')}>the Transtyle language</a>. Your own names stay yours — you bind them once, with <a href={withBase('/docs/adopt-existing/')}>one-line aliases</a>.</p>
    </section>

    <section class="band alt" aria-labelledby="h-honest">
      <h2 id="h-honest">Honest about lossiness</h2>
      <p class="band-sub d-lead">Translation between ecosystems is lossy. Transtyle doesn't hide it — it measures it. Every build classifies every variable, so trust is a number, not a vibe.</p>
      <div class="coverage">
        <div class="cov-bar">
          <span class="seg native" style={`width:${covPct('native')}%`}></span><span class="seg derived" style={`width:${covPct('derived')}%`}></span><span class="seg approx" style={`width:${covPct('approximated')}%`}></span><span class="seg other" style={`width:${covOtherPct}%`}></span>
        </div>
        <div class="cov-legend">
          <span><i class="dot native" aria-hidden="true"></i> native — lossless, first-class mapping</span>
          <span><i class="dot derived" aria-hidden="true"></i> derived — synthesized by rules, provenance recorded</span>
          <span><i class="dot approx" aria-hidden="true"></i> approximated — mapped, meaning changed; reason given</span>
          <span><i class="dot other" aria-hidden="true"></i> dropped — this target can't say it</span>
        </div>
        <p class="cov-counts">Acme on shadcn: {covCount('native')} native · {covCount('derived')} derived · {covCount('approximated')} approximated · {covOther} dropped, of {cov.total} variables.</p>
      </div>
    </section>

    <section class="band" aria-labelledby="h-plugins">
      <h2 id="h-plugins">Every exporter is a plugin</h2>
      <p class="band-sub d-lead">
        The core knows nothing about Bootstrap. All eight official exporters use the same public plugin
        API — resolve the catalog, emit native files, report coverage honestly. The
        <a href={withBase('/docs/exporter-css-variables/')}>css-variables exporter</a> is the reference
        implementation to copy from; the <a href={withBase('/docs/internals/')}>internals guide</a> documents the contract.
      </p>
    </section>

    <section class="band alt" aria-labelledby="h-agents">
      <h2 id="h-agents">Built for humans <em>and</em> agents</h2>
      <p class="band-sub d-lead">
        Deterministic builds, config-as-data, stable diagnostic codes, and a JSON report per build make
        Transtyle operable by AI agents end-to-end — while the compiler itself stays rule-based and auditable.
        Agents write config; the compiler compiles it.
      </p>
      <div class="cta">
        <Button variant="quiet" href={withBase('/docs/ai-agents/')}>The agent guide</Button>
        <Button variant="quiet" href={withBase('/llms.txt')}>llms.txt</Button>
      </div>
    </section>

    <section class="band final" aria-labelledby="h-start">
      <h2 id="h-start">Start compiling</h2>
      <p class="band-sub d-lead">On npm as an alpha — <code>@transtyle/cli@alpha</code>. Prefer to look before you install? The <a href={withBase('/docs/examples/')}>four examples</a> in the repository compile end to end, two of them real systems nobody here designed (GOV.UK, Carbon).</p>
      <div class="start"><Code code={startCommands} lang="bash" {...shiki} /></div>
      <div class="cta center">
        <Button variant="ghost" href={withBase('/docs/getting-started/')}>Getting started guide</Button>
        <Button variant="quiet" href={withBase('/docs/adopt-existing/')}>I already have a design system</Button>
      </div>
    </section>
    </div>
  </main>

  <style>
    .hero { text-align: center; padding: 4.5rem 0 3rem; }
    .eyebrow {
      display: inline-block; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--primary); background: var(--primary-soft); padding: 0.3rem 0.9rem; border-radius: 99px;
      font-family: var(--mono);
    }
    h1 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.08; margin: 1rem 0; }
    /* The second line in cyan: flat colour, no sweep. */
    .grad { color: var(--primary); }
    .sub { max-width: 46rem; margin: 0 auto 1.6rem; font-size: 1.1rem; color: var(--text-muted); }
    .sub strong { color: var(--text); }
    .cta { display: flex; gap: var(--space-3); justify-content: center; flex-wrap: wrap; }
    .hero-post { font-size: 0.9rem; color: var(--text-muted); margin: 1rem auto 0; max-width: 40rem; }
    /* The status line sits between the CTAs and the terminal on purpose: the
       hero makes eight promises, and the reader should learn what they are
       worth before scrolling into the proof, not after installing. */
    .hero-status { font-size: 0.9rem; color: var(--text-muted); margin: 1.5rem auto 0; max-width: 40rem; }
    .hero-status .pill {
      display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--primary); border: 1px solid var(--primary-soft); background: var(--primary-soft);
      padding: 0.1rem 0.5rem; border-radius: 99px; margin-right: 0.35rem; vertical-align: 0.05em;
      font-family: var(--mono);
    }
    .hero-status code { font-size: 0.85em; }
    .cta.center { margin-top: var(--space-6); }

    .terminal {
      max-width: 42rem; margin: 2.6rem auto 0; border-radius: var(--radius-md); overflow: hidden;
      border: 1px solid var(--border); text-align: left;
    }
    .term-bar { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; background: var(--bg-soft); border-bottom: 1px solid var(--border-soft); }
    .term-bar span { width: 11px; height: 11px; border-radius: 50%; background: var(--border); }
    .term-bar em { margin-left: auto; font-size: 0.75rem; color: var(--text-muted); font-style: normal; font-family: var(--mono); }
    .terminal pre { margin: 0; padding: 1.1rem 1.3rem; background: var(--terminal-bg); color: var(--terminal-text); font-size: 0.83rem; line-height: 1.7; overflow-x: auto; }
    .dim { opacity: 0.6; }
    .ok { color: var(--ok); }
    .cov-n { color: var(--cov-native); }
    .cov-d { color: var(--cov-derived); }
    .cov-a { color: var(--cov-approx); }

    .strip { display: flex; flex-wrap: wrap; gap: 0.5rem 1.8rem; justify-content: center; margin-top: 2.4rem; font-size: 0.85rem; color: var(--text-muted); }
    .strip span::before { content: '✓ '; color: var(--ok); }

    .band { padding: var(--space-14) 0; border-top: var(--stroke-hairline) solid var(--color-line); }
    .band h2 { margin: 0 0 var(--space-3); }
    .band-sub { margin: 0 0 var(--space-8); }
    /* Long text on the brand: left-aligned, 32em at most, 1.7 line height, in the reading colour. */
    .band-read { max-width: calc(var(--layout-measure) * 1em); margin: 0 0 var(--space-8); line-height: var(--font-line-height-reading); color: var(--color-fg-reading); }
    .band-foot { max-width: 58ch; margin: var(--space-6) 0 0; color: var(--color-muted); font: var(--type-small); }
    .band .cta { justify-content: flex-start; }

    .pipeline { display: flex; align-items: stretch; gap: var(--space-4); flex-wrap: wrap; }
    .pipe-col { background: var(--color-panel); border: var(--stroke-hairline) solid var(--color-line); padding: var(--space-4) var(--space-5); min-width: 13rem; }
    .pipe-col h3 { margin: 0 0 var(--space-3); font: var(--type-eyebrow); letter-spacing: var(--type-eyebrow-letter-spacing); color: var(--color-muted); }
    .pipe-arrow { align-self: center; color: var(--color-muted); font-size: var(--font-size-xl); }
    .chip { border: var(--stroke-hairline) solid var(--color-line); padding: var(--space-2) var(--space-3); margin: var(--space-2) 0; font-size: var(--font-size-md); font-weight: var(--font-weight-medium); }
    .chip.soon { color: var(--color-muted); border-style: dashed; }
    .chip.soon::after { content: ' · specced'; font-size: var(--font-size-xs); }
    .pipe-col.ir { background: var(--color-tint); border-color: var(--color-primary); }
    .ir-chip { border: none; font-family: var(--font-family-mono); font-size: var(--font-size-sm); }
    .pipe-note { font-size: var(--font-size-sm); color: var(--color-muted); margin: var(--space-3) 0 0; max-width: 13rem; }

    /* The write→get pair is a *transformation*, not a comparison, so it reads as
       two code surfaces joined by an arrow rather than two framed panels. No
       card chrome: the label sits on the page as an eyebrow, and the code block
       is the only object. */
    .transform { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-4); align-items: center; }
    .t-side { min-width: 0; }
    .t-label {
      display: flex; align-items: center; gap: var(--space-2); margin: 0 0 var(--space-2);
      font: var(--type-eyebrow); letter-spacing: var(--type-eyebrow-letter-spacing); text-transform: uppercase; color: var(--color-muted);
    }
    .t-label .prov { text-transform: none; letter-spacing: var(--font-letter-spacing-none); }
    .t-label.mono { font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); text-transform: none; }
    .t-arrow { display: grid; place-items: center; color: var(--color-muted); opacity: 0.6; }
    @media (max-width: 860px) {
      .transform { grid-template-columns: minmax(0, 1fr); }
      .t-arrow { transform: rotate(90deg); padding: var(--space-1) 0; }
    }
    /* Code blocks take the package's `pre` (size, line height, padding, overflow);
       Shiki's own background rule is !important and wins here by design — it
       keeps homepage code identical to the docs pages. Radius, clipping, and
       the ring live on `.code-wrap` (global.css) — one rounded box, not two. */
    .transform pre, .show-src pre { margin: 0; }

    .pipe-tag { display: block; font: var(--type-mono-label); letter-spacing: var(--type-mono-label-letter-spacing); color: var(--color-muted); text-transform: none; margin-top: var(--space-1); }

    /* ---- showcase: one token file → four native-looking previews ---- */
    /* Wide enough for the token snippet's longest line, so the common case is
       "it fits" rather than "it scrolls". */
    .showcase { display: grid; grid-template-columns: minmax(18rem, 1.25fr) 2fr; gap: var(--space-5); align-items: start; }
    @media (max-width: 860px) { .showcase { grid-template-columns: minmax(0, 1fr); } }
    .show-targets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); gap: var(--space-4); }
    .tframe { margin: 0; border: var(--stroke-hairline) solid var(--color-line); background: var(--color-panel); overflow: hidden; }
    .tframe figcaption { font: var(--type-eyebrow); letter-spacing: var(--type-eyebrow-letter-spacing); text-transform: uppercase; color: var(--color-muted); padding: var(--space-2) var(--space-4); border-bottom: var(--stroke-hairline) solid var(--color-line); }
    /* The preview body is the target's own surface (compiled page colour), set
       as --p-* on the element; the frame and caption stay the site's. */
    .tframe .t-ui { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; padding: 0.95rem; min-height: 5.4rem; background: var(--p-page); color: var(--p-text); }

    /* Bootstrap: solid + outline buttons, danger alert */
    .bs-btn { background: var(--p-primary); color: var(--p-on-primary); border: 1px solid var(--p-primary); border-radius: var(--p-radius); padding: 0.32rem 0.8rem; font-size: 0.82rem; font-weight: 500; }
    .bs-btn.outline { background: none; color: var(--p-primary); }
    .bs-alert { flex-basis: 100%; background: var(--p-danger-tint); color: var(--p-danger-on-tint); border: 1px solid var(--p-danger-outline); border-radius: var(--p-radius); padding: 0.35rem 0.7rem; font-size: 0.78rem; }
    /* shadcn: dark scheme, input field */
    .sc-btn { background: var(--p-primary); color: var(--p-on-primary); border-radius: var(--p-radius); padding: 0.32rem 0.85rem; font-size: 0.82rem; font-weight: 600; }
    .sc-btn.ghost { background: transparent; color: var(--p-text); border: 1px solid var(--p-border); font-weight: 500; }
    .sc-input { flex-basis: 100%; border: 1px solid var(--p-border); border-radius: var(--p-radius-field); padding: 0.32rem 0.7rem; font-size: 0.78rem; color: var(--p-muted); }
    /* daisyUI: name translation danger→error, toggle control */
    .dy-btn { background: var(--p-primary); color: var(--p-on-primary); border-radius: var(--p-radius); padding: 0.32rem 0.85rem; font-size: 0.82rem; font-weight: 600; }
    .dy-badge { background: var(--p-danger); color: var(--p-on-danger); border-radius: var(--p-radius-full); padding: 0.12rem 0.6rem; font-size: 0.72rem; font-weight: 600; }
    .dy-toggle { width: 2.5rem; height: 1.35rem; border-radius: var(--p-radius-full); background: var(--p-primary); position: relative; display: inline-block; }
    .dy-toggle i { position: absolute; top: 2px; right: 2px; width: calc(1.35rem - 4px); height: calc(1.35rem - 4px); border-radius: 50%; background: var(--p-on-primary); }
    /* ECharts: bars from the derived categorical palette */
    .t-ui.chart { align-items: flex-end; gap: 0.45rem; height: 5.4rem; padding-bottom: 0.7rem; }
    .t-ui.chart i { flex: 1; height: var(--h); background: var(--c); border-radius: 3px 3px 0 0; }

    .xlate { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
    .x-src { display: flex; align-items: center; gap: var(--space-1); border: var(--stroke-hairline) solid var(--color-line); padding: var(--space-3) var(--space-5); background: var(--color-panel); }
    .x-arrow { color: var(--color-muted); font-size: var(--font-size-xl); }
    .x-out { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
    .x-out li { display: flex; align-items: baseline; gap: var(--space-3); justify-content: space-between; border: var(--stroke-hairline) solid var(--color-line); padding: var(--space-1) var(--space-3); background: var(--color-panel); }
    .x-out em { font-style: normal; font-size: var(--font-size-sm); color: var(--color-muted); }

    .coverage { max-width: 44rem; }
    .cov-bar { display: flex; height: 2.4rem; overflow: hidden; font-size: var(--font-size-sm); font-weight: var(--font-weight-semibold); color: var(--color-on-primary); }
    .seg { display: grid; place-items: center; }
    .seg.native, .dot.native { background: var(--cov-native); }
    .seg.derived, .dot.derived { background: var(--cov-derived); }
    .seg.approx, .dot.approx { background: var(--cov-approx); }
    .seg.other, .dot.other { background: color-mix(in oklch, var(--color-muted) 45%, transparent); }
    .cov-counts { margin: var(--space-3) 0 0; font-size: var(--font-size-md); color: var(--color-muted); }
    .cov-legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4); font-size: var(--font-size-md); color: var(--color-muted); }
    .dot { display: inline-block; width: 10px; height: 10px; border-radius: var(--radius-sm); margin-right: var(--space-2); }

    /* Shiki paints the code block itself (its background rule carries
       !important), so this is only a width container — giving it a
       terminal background too would double up behind the highlighted block. */
    .band.final .start { max-width: 42rem; }
    /* Radius/clipping/ring come from `.code-wrap` (global.css) now, not a border here. */
    .band.final .start pre { margin: 0; }
    /* The demo-gallery strip: four design systems as four real palettes. The card
       is the package's ProjectCard look: square, a hairline, the title under the
       dimension line, and the lift on hover, all on the motion tokens. */
    .gallery-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: var(--space-3); margin: var(--space-6) 0 0; }
    .gcard {
      display: block; border: var(--stroke-hairline) solid var(--color-line); padding: var(--space-4); background: var(--color-panel); color: var(--color-fg);
      transition: border-color var(--motion-duration-dimension) var(--motion-easing-precise), transform var(--motion-duration-dimension) var(--motion-easing-precise);
    }
    .gcard:hover { text-decoration: none; color: var(--color-fg); border-color: var(--color-primary); transform: translateY(-2px); }
    .gswatch { display: flex; gap: var(--space-1); margin-bottom: var(--space-3); }
    .gswatch i { flex: 1; height: 1.5rem; border-radius: var(--radius-sm); border: var(--stroke-hairline) solid var(--color-line); }
    .gname { display: block; font: var(--type-heading); letter-spacing: var(--type-heading-letter-spacing); text-transform: uppercase; }
    .gkicker { display: block; margin-top: var(--space-1); font: var(--type-eyebrow); letter-spacing: var(--type-eyebrow-letter-spacing); text-transform: uppercase; color: var(--color-muted); }
  </style>
</Base>
